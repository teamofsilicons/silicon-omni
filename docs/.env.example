# Any Postgres connection string. On Vercel, add a Neon/Postgres store and this
# is injected for you as DATABASE_URL (or POSTGRES_URL — either is read).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Shared secret for /dial. Anyone with it can change what every omni install
# resolves to, so treat it like a deploy key.
ADMIN_TOKEN=change-me
